# Credenciales de despliegue — copiar a .env.deploy (fuera de git) y completar.
# NUNCA commitear el archivo con valores reales.
#
#   cp .env.deploy.example .env.deploy && chmod 600 .env.deploy

# Servidor destino
SANATORIO_SSH_HOST=
SANATORIO_SSH_USER=
SANATORIO_SSH_PORT=22

# Autenticación recomendada: llave SSH (dejar SANATORIO_SSH_PASSWORD vacío)
SANATORIO_SSH_KEY=~/.ssh/id_ed25519
SANATORIO_SSH_KEY_PASSPHRASE=

# Fallback desaconsejado: contraseña. Sólo mientras no haya llave configurada.
SANATORIO_SSH_PASSWORD=

# Verificación del host. En producción cargá known_hosts sólo después de
# comparar el fingerprint por un canal independiente. ACCEPT_NEW=1 es TOFU y
# queda reservado a entornos descartables; el runbook de producción lo prohíbe.
SANATORIO_SSH_KNOWN_HOSTS=
SANATORIO_SSH_ACCEPT_NEW=0
