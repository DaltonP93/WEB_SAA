# Copiar a api/.env y completar. NUNCA commitear api/.env.
# En producción este archivo lo genera scripts/deploy/setup-vps.sh con valores
# aleatorios y permisos 600.

PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sanatorio
DB_PASS=
DB_NAME=sanatorio

# Obligatorio en producción: la API se niega a arrancar con el valor de ejemplo
# o con un secreto de menos de 32 caracteres.
# Generar con:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
# Debe quedar fuera de UPLOAD_DIR y en el mismo filesystem.
UPLOAD_STAGING_DIR=./.uploads-staging
MAX_UPLOAD_MB=10

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_BASE_URL=http://localhost:4000
# URL pública real del sitio (canonical, sitemap, prerender).
PUBLIC_SITE_URL=http://localhost:5173

# Usuario administrador que crea el seed.
# SEED_ADMIN_PASSWORD es obligatoria cuando NODE_ENV=production; en desarrollo,
# si se deja vacía, el seed usa una contraseña de desarrollo y avisa por consola.
SEED_ADMIN_EMAIL=admin@sanatorio.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador

# Formularios públicos (turnos y contacto).
# Ventana y máximo de envíos por IP.
PUBLIC_FORMS_RATE_WINDOW_MS=900000
PUBLIC_FORMS_RATE_MAX=10

# Anti-spam opcional. Mientras estén vacías, la verificación queda desactivada
# y los formularios siguen funcionando (no se inventan claves).
# Proveedores soportados: turnstile | recaptcha
# Las tres van juntas: con sólo una parte cargada la API avisa en el arranque
# y la verificación queda desactivada. SITE_KEY es pública (la usa el widget);
# SECRET_KEY nunca sale del servidor.
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
